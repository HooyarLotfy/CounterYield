{
  "expo": {
    "name": "CounterYield",
    "slug": "counteryield",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": ["ios", "android", "web"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "xyz.counteryield.app"
    },
    "android": {
      "package": "xyz.counteryield.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0D0E11"
      },
      "permissions": [
        "REQUEST_INSTALL_PACKAGES",
        "INTERNET",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ],
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro"
    }
  }
}
