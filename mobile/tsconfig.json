{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "resolveJsonModule": true,
    "baseUrl": "."
  },
  "include": ["App.tsx", "index.js", "src/**/*", "*.d.ts"],
  "exclude": ["node_modules"]
}
